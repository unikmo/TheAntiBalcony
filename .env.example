# One-time prices: $399 / $799 / $2,999 / legacy VIP $9,999.
STRIPE_PRICE_SNAPSHOT=
STRIPE_PRICE_VIDEO=
STRIPE_PRICE_TAKEOVER=
STRIPE_PRICE_VIP=

# Blindspot inventory + booking adapter
# Contract: check/hold eligible Times Square inventory BEFORE Stripe, then confirm after payment.
# Customer promise: guaranteed date + confirmed 4-hour ET window; no exact-minute guarantee.
BLINDSPOT_BOOKING_BRIDGE_URL=
BLINDSPOT_BOOKING_BRIDGE_SECRET=
# Safe default is false. Only enable if the provider contract explicitly permits checkout without an inventory hold.
BLINDSPOT_ALLOW_UNHELD_CHECKOUT=false
# Legacy/alternate bridge name supported by the provider adapter.
BLINDSPOT_API_BRIDGE_URL=

# EarthCam / licensed proof capture adapter
# Use only licensed archive/partner/API access; never scrape or rebroadcast the public webcam feed.
EARTHCAM_CAPTURE_BRIDGE_URL=
EARTHCAM_CAPTURE_BRIDGE_SECRET=

# Provider callbacks into the booking state machine.
PROVIDER_CALLBACK_SECRET=
# Legacy callback secret still supported.
FULFILLMENT_CALLBACK_SECRET=

