# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-managed persistence)
# Project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=
# Recommended modern server-only secret key. Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Legacy compatibility: use only if your project still uses a service-role JWT.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create four one-time prices: $399 / $799 / $2,999 / $9,999.
STRIPE_PRICE_SNAPSHOT=
STRIPE_PRICE_VIDEO=
STRIPE_PRICE_TAKEOVER=
STRIPE_PRICE_VIP=

# Zapier Free-plan architecture
# Zap A: Catch Hook -> Email by Zapier. Receives both fulfillment_created and proof_required events.
ZAPIER_OPERATIONS_WEBHOOK_URL=
# Zap B: Catch Hook -> Email by Zapier. Receives proof-ready social approval events only.
ZAPIER_SOCIAL_WEBHOOK_URL=

# Backward-compatible provider aliases. Leave blank for the recommended two-hook Zapier setup.
ZAPIER_BILLBOARD_WEBHOOK_URL=
ZAPIER_PROOF_WEBHOOK_URL=
BILLBOARD_FULFILLMENT_WEBHOOK_URL=
PROOF_CAPTURE_WEBHOOK_URL=
SOCIAL_PUBLISH_WEBHOOK_URL=

# Optional bearer secrets for non-Zapier provider bridges.
BILLBOARD_FULFILLMENT_WEBHOOK_SECRET=
PROOF_CAPTURE_WEBHOOK_SECRET=
SOCIAL_PUBLISH_WEBHOOK_SECRET=

# Required for provider/internal ops -> app status callbacks.
# Zapier is notification-only in the Free-plan architecture; status changes should be controlled by The Anti-Balcony backend/admin ops UI.
FULFILLMENT_CALLBACK_SECRET=

# Concierge operations
# Physical packages stay in ops_review until crew, inventory, permit/insurance
# requirements and talent releases are cleared by the operations workflow.
TAKEOVER_OPERATIONS_EMAIL=

# Optional founder email via Resend REST API
RESEND_API_KEY=
RESEND_FROM=The Anti-Balcony <launch@yourdomain.com>
