# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Admin / Firestore
FIREBASE_PROJECT_ID=theantibalcony
FIREBASE_CLIENT_EMAIL=
# Keep this server-only. Vercel accepts the private key with escaped \n characters.
FIREBASE_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Create four one-time prices: $399 / $799 / $2,999 / $9,999.
STRIPE_PRICE_SNAPSHOT=
STRIPE_PRICE_VIDEO=
STRIPE_PRICE_TAKEOVER=
STRIPE_PRICE_VIP=

# Zapier orchestration
# Webhooks by Zapier -> Catch Hook. Keep these URLs private/server-side.
ZAPIER_BILLBOARD_WEBHOOK_URL=
ZAPIER_PROOF_WEBHOOK_URL=
ZAPIER_SOCIAL_WEBHOOK_URL=

# Optional generic aliases if a provider replaces Zapier later.
BILLBOARD_FULFILLMENT_WEBHOOK_URL=
PROOF_CAPTURE_WEBHOOK_URL=
SOCIAL_PUBLISH_WEBHOOK_URL=

# Optional bearer secrets for non-Zapier provider bridges.
BILLBOARD_FULFILLMENT_WEBHOOK_SECRET=
PROOF_CAPTURE_WEBHOOK_SECRET=
SOCIAL_PUBLISH_WEBHOOK_SECRET=

# Required for Zapier/provider -> app status callbacks.
FULFILLMENT_CALLBACK_SECRET=

# Concierge operations (recommended integrations/records)
# Physical packages stay in ops_review until crew, inventory, permit/insurance
# requirements and talent releases are cleared by the operations workflow.
TAKEOVER_OPERATIONS_EMAIL=

# Optional founder email via Resend REST API
RESEND_API_KEY=
RESEND_FROM=The Anti-Balcony <launch@yourdomain.com>
