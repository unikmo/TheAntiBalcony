# Public
NEXT_PUBLIC_SITE_URL=https://thepopmoment.com

# Admin dashboard (required for /admin)
ADMIN_DASHBOARD_PASSWORD=

# Supabase (server-managed persistence + private creative/proof storage)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Legacy founder-launch price IDs. The Pop Moment consumer checkout uses inline $399 / $549 prices.
STRIPE_PRICE_SNAPSHOT=
STRIPE_PRICE_VIDEO=
STRIPE_PRICE_TAKEOVER=
STRIPE_PRICE_VIP=

# Blindspot inventory + booking adapter
# Charge-first operating model: after Stripe succeeds, route preferred 4h -> backup 4h -> any same-day window.
# Genuine same-day non-fulfillment falls back to the automatic-refund workflow.
BLINDSPOT_BOOKING_BRIDGE_URL=
BLINDSPOT_BOOKING_BRIDGE_SECRET=
BLINDSPOT_API_BRIDGE_URL=

# EarthCam / licensed proof capture adapter
# Use only licensed archive/partner/API access; never scrape or rebroadcast the public webcam feed.
EARTHCAM_CAPTURE_BRIDGE_URL=
EARTHCAM_CAPTURE_BRIDGE_SECRET=

# Provider callbacks into the booking state machine.
PROVIDER_CALLBACK_SECRET=
FULFILLMENT_CALLBACK_SECRET=

# Legacy Zapier/provider bridges for the founder-launch workflow.
ZAPIER_OPERATIONS_WEBHOOK_URL=
ZAPIER_SOCIAL_WEBHOOK_URL=
ZAPIER_BILLBOARD_WEBHOOK_URL=
ZAPIER_PROOF_WEBHOOK_URL=
BILLBOARD_FULFILLMENT_WEBHOOK_URL=
PROOF_CAPTURE_WEBHOOK_URL=
SOCIAL_PUBLISH_WEBHOOK_URL=
BILLBOARD_FULFILLMENT_WEBHOOK_SECRET=
PROOF_CAPTURE_WEBHOOK_SECRET=
SOCIAL_PUBLISH_WEBHOOK_SECRET=

# Customer email via Resend REST API
RESEND_API_KEY=
RESEND_FROM=The Pop Moment <moments@thepopmoment.com>
